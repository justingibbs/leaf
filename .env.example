# LEAF Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI Configuration (Required)
# =============================================================================

# Pydantic AI Gateway - Free tier for Gemini models
# Get your API key from: https://ai.pydantic.dev/
# This provides free access to Google Gemini models
PYDANTIC_AI_API_KEY=your-pydantic-ai-gateway-key-here

# Default model to use (via Pydantic AI Gateway)
# Options: google-gla:gemini-2.0-flash, google-gla:gemini-1.5-pro, etc.
LEAF_MODEL=google-gla:gemini-2.0-flash

# =============================================================================
# Application Settings (Optional)
# =============================================================================

# Server port (default: 8000)
# LEAF_PORT=8000

# Log level: debug, info, warning, error (default: info)
# LEAF_LOG_LEVEL=info

# Override app config directory (default: ~/.leaf)
# LEAF_CONFIG_DIR=~/.leaf
